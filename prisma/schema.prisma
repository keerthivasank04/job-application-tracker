model User {
  id                   Int             @id @default(autoincrement())
  email                String          @unique
  passwordHash         String
  name                 String?
  linkedinUrl          String?
  githubUrl            String?
  resetPasswordToken   String?
  resetPasswordExpires TimestamptzString?
  createdAt            TimestamptzString        @default(now())
  updatedAt            TimestamptzString        @default(now())
  applications         Application[]
}

model Application {
  id                 Int             @id @default(autoincrement())
  company            String
  role               String
  status             String          @default("Applied")
  notes              String?
  salaryMin          Int?
  salaryMax          Int?
  currency           String?         @default("USD")
  jobLocation        String?
  jobPostUrl         String?
  resumePath         String?
  resumeOriginalName String?
  resumeMimeType     String?
  resumeUploadedAt   TimestamptzString?
  appliedDate        TimestamptzString        @default(now())
  userId             Int
  user               User            @relation(fields: [userId], references: [id])
  statusHistory      StatusHistory[]
  interviews         Interview[]
}

model StatusHistory {
  id            Int         @id @default(autoincrement())
  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id])
  fromStatus    String
  toStatus      String
  notes         String?
  changedAt     TimestamptzString    @default(now())
}

model Interview {
  id            Int         @id @default(autoincrement())
  applicationId Int
  application   Application @relation(fields: [applicationId], references: [id])
  roundName     String
  scheduledDate TimestamptzString
  meetingLink   String?
  interviewer   String?
  feedbackNotes String?
  status        String      @default("Scheduled")
  createdAt     TimestamptzString    @default(now())
  updatedAt     TimestamptzString    @default(now())
}
