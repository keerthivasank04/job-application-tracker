model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Application {
  id          Int      @id @default(autoincrement())
  company     String
  role        String
  status      String   @default("Applied")
  appliedDate DateTime @default(now())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
}