# PostgreSQL connection string (PostgreSQL 15+)
DATABASE_URL="postgresql://jobtracker_user:jobtracker_password@localhost:5432/jobtracker_db"

# Secret used to sign login tokens. Use a long random value (32+ chars required in production).
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# How long a login session lasts (e.g. 2h, 12h, 7d)
JWT_EXPIRES_IN="12h"

PORT=3000

# CORS origin allowed to call the API ("*" for any). The built-in dashboard is same-origin.
ALLOWED_ORIGIN="*"

# Comma-separated emails allowed to call GET /admin/stats
ADMIN_EMAILS=""

# Optional rate-limit tuning (requests per 15 minutes per IP)
# API_RATE_LIMIT=1000
# AUTH_RATE_LIMIT=10

# Set when running behind a reverse proxy (e.g. 1) so client IPs are detected correctly
# TRUST_PROXY=1
