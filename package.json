{
  "name": "job_tracker",
  "type": "module",
  "version": "1.2.0",
  "description": "Job application tracker: Express 5 + Prisma Next + PostgreSQL REST API with a built-in web dashboard.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,json --exec node --import tsx src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test node --import tsx --test --test-concurrency=1 --test-reporter=spec tests/*.test.ts",
    "postinstall": "prisma skills sync || exit 0",
    "contract:emit": "prisma contract emit",
    "db:init": "prisma db init",
    "seed": "node --import tsx src/scripts/seed.ts",
    "test:e2e": "node tests/e2e/dashboard.e2e.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.10",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.7.0"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.2.3",
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/supertest": "^2.0.12",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.14",
    "prisma": "8.0.0-rc.10",
    "supertest": "^6.3.3",
    "typescript": "^5.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keerthivasank04/job-application-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/keerthivasank04/job-application-tracker/issues"
  },
  "homepage": "https://github.com/keerthivasank04/job-application-tracker#readme",
  "engines": {
    "node": ">=22"
  }
}
